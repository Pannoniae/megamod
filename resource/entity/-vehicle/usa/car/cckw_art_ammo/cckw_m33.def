{game_entity
	(include "/properties/car.ext")
	(include "/properties/selection/vehicle_elongated.inc" scale(1.15))
	{props "with_gun" "truck" "vision_lev00_can" "muzzle_hmg" "tractor" "tractor_heavy"}
	{able "emit_on_attack"}
	{extension "cckw_m33.mdl"}
	{targetSelector "rocket"}
	{targetclass "howitzer"}
	{collider "truck"}
	{patherId "cckw"}

	("wheel" args "wheelright1")
	("wheel" args "wheelleft1")
	("wheel" args "wheelright2")
	("wheel" args "wheelleft2")
	("wheel" args "wheelright3")
	("wheel" args "wheelleft3")
	
	
	("shield_group" args "shield" 5 "shield")
	("shield_group" args "shield1" 5 "shield")
	("shield_group" args "shield2" 5 "shield")
	("shield_group" args "shield3" 5 "shield")

	("gun" repair(30) thickness(15))

	{volume "magazine01" {thickness 6}}
	{volume "magazine02" {thickness 6}}
	{volume "turret1" {thickness 6}}
	{volume "turret2" {thickness 6}}
	{volume "turret3" {thickness 6}}
	{volume "turret4" {thickness 6}}
	{volume "turret5" {thickness 6}}
	{volume "turret6" {thickness 6}}
	{volume "turret7" {thickness 6}}
	{volume "turret8" {thickness 6}}
	{volume "turret9" {thickness 6}}
	{volume "turret10" {thickness 6}}
	{volume "turret11" {thickness 6}}

	("glass" args "window1")
	("glass" args "window2")
	("fuel" args "fuel")
	("transmission" args "transmission")

	("bodyback" repair(30))

	("shield_cover")

	{volume "detail2"
		{thickness 1}
	}

	{volume "body2" {able {holed}}}
	{volume "body3" {able {holed}}}
	{volume "body4" {able {holed}}}
	{volume "bodyback1" {able {holed}}}
	{volume "shield_cover" {able {holed}}}
	{volume "fuel" {able {NoWoundDecal 0}}}

	("crew_2_human")

	("board_animation"
		place(driver)
		board_begin(board_big-midcar_driver)
		board_end(seat_driver_car)
		base(doorleft)
	)
	("board_animation"
		place(commander)
		board_begin(board_big-midcar)
		board_end(seat_passenger)
		base(doorright)
	)
	{boarder
		{anm "gunner"
			{forward {begin "board_MiddleArmor"} {end "seat_m45_gunner"}}
			{reverse {end "emit_tank_1"}}
		}
		{anm "charger"
			{forward {begin "board_MiddleArmor"} {end "pose_flak30_loader"}}
			{reverse {end "emit_tank_1"}}
		}
	}
	("crew" place(gunner)		bone(gunner)	door(emit3)	animation(gunner)	 visor(main) off())
	("crew" place(charger)		bone(charger)	door(emit4)	animation(charger)	 visor(main) off())

	{extender "shield" {on}}

	
	{extender "inventory"
		{box
			{item "ammo hmgun_usa api" 1600} ;// API, AA or aircraft ammunition, explodes on impact
			{item "repair_kit" {cell 4 0}}
		}
	}

	{Weaponry
		{place "mgun"
			{Barrels 2}
			{type "main"}
			{foresight "foresight14"}
			{gunner "gunner"}
			{charger "charger"}
			{weapon "browning_m2_x2" filling "hmgun_usa api" 800}
			("abm_mgun")
			{Rotate}
			{basic}
		}
	}
	{mass 4800} ;// 4000 + 800
	{Chassis
		("car_trace" fx("tracewheel03") step(0.08) wheell("wlf") wheelr("wrf") bonel("FXtraceL1") boner("FXtraceR1"))
		("car_trace" fx("tracewheel03d") step(0.08) wheell("wlr") wheelr("wrr") bonel("FXtraceL2") boner("FXtraceR2"))
		("mobility_car"
			speed(72) ;----------------------------------Max speed.
			speedatmaxturn(15) ;-------------------------Max speed at max turn.
			reverse(22) ;--------------------------------Max speed in Reverse.
			weight(4.8) ;--------------------------------Weight in Tonnes.
			power(104) ;---------------------------------Horse Power.
			fuel(150) ;----------------------------------Fuel capacity in Litres.
			type(fuel) ;---------------------------------Fuel type.
			range(480) ;---------------------------------Range in Kilometers.
		)
	}
	{bone "gun_rot"
		{limits -5 88}
		{speed2 60}
	}
	{bone "turret"
		{speed2 60}
	}
}
