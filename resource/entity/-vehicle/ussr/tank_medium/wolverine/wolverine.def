{game_entity
	(include "/properties/tank.ext")
	(include "/properties/shadow/tank.inc" scale(1.3))
	(include "/properties/selection/vehicle.inc" scale(1.2))
	{props "medium" "vision_lev04" "muzzle_75mm_76mm" "diesel"}
	{targetclass "tank_medium"}
	{targetSelector "tank_medium"}

	{extender "enumerator"
		{digit_folder "ru1"}
	}

	("tank_medium_tier2")

	("tracks" repair(30) thickness(30))
	("gun" repair(30) thickness(30))

	{Volume "body1"
		{tags "body"}
		{component "body"}
		{thickness 19
			{front 51}		
			{top 22}		
			{rear 20}
			{bottom 22}
		}
	}
	{Volume "body2"
		{tags "body"}
		{component "body"}
		{thickness 25
			{front 57}		
			{top 22}		
			{rear 20}
			{bottom 22}
		}
	}
	{Volume "turret1"
		{tags "turret"}
		{component "turret"}
		{thickness 25
			{front 35}		
			{top 19}
			{bottom 19}
		}
	}
	{Volume "turret2"
		{tags "turret"}
		{component "turret"}
		{thickness 25
			{front 35}		
			{top 19}
			{bottom 19}
		}
	}
	{Volume "turret3"
		{tags "turret"}
		{component "turret"}
		{thickness 25
			{front 35}		
			{top 19}
			{bottom 19}
		}
	}
	{Volume "turret4"
		{tags "turret"}
		{component "turret"}
		{thickness 25
			{front 35}		
			{top 19}
			{bottom 19}
		}
	}
	{Volume "turret5"
		{tags "turret"}
		{component "turret"}
		{thickness 25
			{front 35}		
			{top 19}
			{bottom 19}
		}
	}
	{Volume "turret6"
		{tags "turret"}
		{component "turret"}
		{thickness 25
			{front 35}		
			{top 19}
			{bottom 19}
		}
	}
	{Volume "turret7"
		{tags "turret"}
		{component "turret"}
		{thickness 25
			{front 35}		
			{top 19}
			{bottom 19}
		}
	}
	{Volume "mantlet"
		{tags "turret"}
		{component "turret"}
		{thickness 57}
	}

	{volume "engine"		
		{thickness 25
			{front 40}
			{top 19}
			{rear 25}
			{bottom 19}		
		}
	}


	("crew_4_human")
	{boarder
		{anm "left"
			{forward	{begin	"board_tank_right"} {end "pose_mgun_pz6"}}
			{reverse 	{end	"emit_tank_2_hold"}}
		}
		{anm "right"
			{forward	{begin	"board_tank_left"} {end "pose_mgun_pz6"}}
			{reverse 	{end	"emit_tank_2_hold"}}
		}
		{anm "armor"
			{forward	{begin	"board_lowArmor"} 	{end "pose_seat_armor_2"}}
			{reverse 	{end	"emit_tank_2"}}
		}
		{anm "armor1"
			{forward	{begin	"board_lowArmor"} {end "pose_seat_armor_2"}}
			{reverse 	{end	"emit_body"}}
		}
		{anm "armor2"
			{forward	{begin	"board_lowArmor"} {end "pose_seat_armor_1"}}
			{reverse 	{end	"emit_body"}}
		}
		{anm "gunner"			
			{forward	{begin	"board_hummel"} {end "pose_pak40_gunlayer"} {base "open_back_door"}}
			{reverse 	{end	"emit_body" 1} {base "open_back_door" -1}}
		}
		{anm "commander"
			{forward	{begin	"board_hummel"} {end "pose_seat_armor_2"} {base "open_back_door"}}
			{reverse 	{end	"emit_body" 1} {base "open_back_door" -1}}
		}
	}
	
	{sensor
		{visor "mgun2"
			{vision "human"}
			{bone "mgun2"}
		}
	}

	("crew_human_visible" place(gunner2) door1(emit1) door2(emit2) visor(mgun2))
	("crew_human" 		place(driver)	door1(emit1) door2(emit2) visor(driver))
	("crew_human_visible" place(commander) door1(emit1) door2(emit2) visor(main))
	("crew_human_visible" place(gunner)	door1(emit1) door2(emit2) visor(main))
	{placer 
		{place "commander" {openForCrush 0}}
		{place "gunner" {openForCrush 0}}
	}
	
	
	("seat_human" place(seat1) bone(seat01) door(emit3)  animation(armor1))
	("seat_human" place(seat2) bone(seat02) door(emit4)  animation(armor))
	("seat_human" place(seat3) bone(seat03) door(emit5)  animation(armor))
	("seat_human" place(seat4) bone(seat04) door(emit6)  animation(armor1))	

	{extender "inventory"
		{box
			{item "ammo bulletusa_76x539 ap" 15}
			{item "ammo bulletusa_76x539 apcbche" 24}
			{item "ammo bulletusa_76x539 he" 15}
			{item "ammo hmgun_usa" 600}
		}
	}
	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "76mm_m1a1c" filling "ammo bulletusa_76x539 ap" 1}	
			{gunner "gunner"}
			{charger "charger"}
			("abm_dymamic_td"
				zeroing(2.5)
				dispersion(0.25)
			)
		}
		{place "mgun"
			{type "aa"}
			{weapon "browning_m2_hb" filled}
			{gunner "gunner2"}
			{charger "gunner2"}
			{LinkBone "mgun_rot"}
			("abm_mgun")
			{basic}
			{ai_in_manual}
		}
	}
	
	{mass 29600}
	{Chassis
		("tank_trace" fx("tracks_mid") step(0.52) len(0.45))
		("mobility_tank"
			speed(42) ;----------Max speed when fully accelerated on road, km/h.
			reverse(5) ;---------Max speed in reverse on road, km/h.
			traverse(30) ;-------Track traverse, per second, in degrees.
			weight(29.6) ;-------Weight in Tonnes.
			power(410) ;---------Engine Power, in hp. //engine under normal use was rated 265hp at 2600 rpm
			track(4.5) ;---------Track performance: (0,10], 10=ideal. Sluggish tanks and vehicles with narrow and non-gripping tracks have a lower performance.
			fuel(560) ;----------Fuel capacity in Litres.
			type(diesel) ;---------Fuel type. (diesel OR fuel)
			range(240) ;---------Range in km, off-road.
		)
	}
	{Extension "m10wolverine.mdl"}

	{bone "turret_mgun"
		{limits -22 38}
		{speed2 18}
		{terminator}
	}

	{bone "turret"
		{speed2 5}
	}

	{bone "gun_rot"
		{speed2 5}
	}
}
